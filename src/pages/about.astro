---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Timeline from '../components/Timeline.astro';
import Education from '../components/Education.astro';
import { aboutStats, aboutValues, alwaysLearning, profile } from '../data/site';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="About"
  description="About M Vinay Sagar — curious engineer building real impact at DRDL, Hyderabad: experience, education and the principles behind the work."
>
  <section class="mx-auto max-w-7xl px-5 pt-32 sm:px-8 md:pt-36">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.15fr] lg:items-start">
      <!-- Left: intro -->
      <div>
        <div class="flex flex-wrap items-center gap-3" data-animate>
          <span class="eyebrow">
            <span class="dot-glow h-2 w-2 rounded-full bg-brand-500"></span>
            About Me
          </span>
          <span class="chip !bg-white">
            <Icon name="book" class="h-3.5 w-3.5 text-brand-500" />
            Experience • Education • My Journey
          </span>
        </div>

        <h1 class="mt-6 text-4xl font-extrabold leading-[1.05] sm:text-5xl" data-animate data-delay="0.06">
          Curious Engineer Building
          <span class="text-gradient">Real Impact.</span>
        </h1>

        <p class="mt-5 max-w-xl leading-relaxed text-navy-500" data-animate data-delay="0.1">
          {profile.aboutIntro}
        </p>

        <a href={profile.resumePdf} target="_blank" rel="noopener" class="btn-ghost mt-5" data-animate data-delay="0.12">
          <Icon name="download" class="h-4 w-4 text-brand-600" /> Download Resume
        </a>

        <div class="mt-6 flex flex-wrap gap-2.5" data-animate data-delay="0.14">
          {
            aboutValues.map((value) => (
              <span class="chip !bg-white !px-3.5 !py-2">
                <span class="grid h-5 w-5 place-items-center rounded-md bg-brand-500 text-white">
                  <Icon name="check" class="h-3 w-3" />
                </span>
                {value}
              </span>
            ))
          }
        </div>

        <dl class="mt-6 grid grid-cols-2 gap-3" data-animate data-delay="0.18">
          {
            aboutStats.map((stat) => (
              <div class="card card-hover !rounded-2xl p-4 text-center">
                <dt class="mx-auto grid h-9 w-9 place-items-center rounded-xl bg-brand-50 text-brand-600">
                  <Icon name={stat.icon} class="h-4.5 w-4.5" />
                </dt>
                <dd class="mt-2">
                  <span class="block font-display text-[0.98rem] font-extrabold text-navy-950">{stat.value}</span>
                  {'sub' in stat && stat.sub && (
                    <span class="block text-[0.7rem] font-semibold text-brand-500">{stat.sub}</span>
                  )}
                  <span class="block text-[0.7rem] text-navy-400">{stat.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-5 grid gap-3 sm:grid-cols-[1.3fr_1fr]" data-animate data-delay="0.22">
          <figure class="card !rounded-2xl p-5">
            <Icon name="quote" class="h-7 w-7 text-brand-300" />
            <blockquote class="mt-2 text-[0.88rem] italic leading-relaxed text-navy-600">
              I love working at the intersection of engineering, data and design — building tools
              that help people understand, analyse and make better decisions.
            </blockquote>
            <figcaption class="font-hand mt-3 text-right text-2xl text-brand-600">M Vinay Sagar</figcaption>
          </figure>

          <div class="card !rounded-2xl p-5">
            <p class="flex items-center gap-2 font-display text-sm font-extrabold text-navy-950">
              <Icon name="sparkles" class="h-4 w-4 text-brand-500" />
              Always Learning
            </p>
            <ul class="mt-3 space-y-2">
              {
                alwaysLearning.map((item) => (
                  <li class="flex items-center gap-2 text-[0.8rem] text-navy-500">
                    <span class="grid h-5 w-5 place-items-center rounded-full bg-brand-50 text-brand-600">
                      <Icon name="check" class="h-3 w-3" />
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Right: timeline -->
      <div id="experience" class="scroll-mt-28" data-animate data-animate-scroll>
        <Timeline entries={experience} showAnnotation />
      </div>
    </div>

    <Education />
  </section>
</BaseLayout>
