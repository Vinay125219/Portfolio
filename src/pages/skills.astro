---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import ExploreMore from '../components/ExploreMore.astro';
import SkillsExplorer from '../islands/SkillsExplorer';
import type { ProjectMeta } from '../islands/SkillsExplorer';
import { skillHighlights } from '../data/skills';

const projectEntries = await getCollection('projects');
const projects: Record<string, ProjectMeta> = Object.fromEntries(
  projectEntries.map((p) => [p.id, { title: p.data.title, tags: p.data.tags, image: p.data.image }])
);

const stats = [
  { icon: 'sparkles', value: '15+', label: 'Tools & Technologies' },
  { icon: 'folder', value: 'Real Projects', label: 'With practical application' },
  { icon: 'target', value: 'Continuous Learning', label: 'Always exploring more' },
];
---

<BaseLayout
  title="Skills"
  description="Skills, tools and systems M Vinay Sagar works with — Python, Qt/C++, QML, Flutter, SQL, data visualization, AI tooling and professional skills, with related projects."
>
  <PageHeader
    eyebrow="Skills Explorer"
    title="Skills, tools and systems"
    accent="I work with."
    lead="A comprehensive view of the technologies, tools and systems I use to build, analyze, visualize and deliver real-world solutions. Explore the interactive map, click on any skill to see details, related projects and how I apply it in practice."
    annotation="Different tools. Stronger solutions. Real impact."
    icon="layers"
  >
    <Fragment slot="chips">
      <span class="chip !bg-white">
        <Icon name="compass" class="h-3.5 w-3.5 text-brand-500" />
        Explore my technical and professional toolkit
      </span>
    </Fragment>
    <div slot="actions" class="grid w-full grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-3">
      {
        stats.map((s) => (
          <div class="card flex items-center gap-3 !rounded-2xl p-3.5">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={s.icon} class="h-4.5 w-4.5" />
            </span>
            <span>
              <span class="block font-display text-sm font-extrabold text-navy-950">{s.value}</span>
              <span class="block text-[0.68rem] text-navy-400">{s.label}</span>
            </span>
          </div>
        ))
      }
    </div>
  </PageHeader>

  <section class="mx-auto max-w-7xl px-5 sm:px-8">
    <div data-animate data-animate-scroll>
      <SkillsExplorer client:load projects={projects} />
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        skillHighlights.map((group) => (
          <article class="card card-hover p-5" data-animate data-animate-scroll>
            <div class="flex items-center justify-between">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-aqua-400 text-white">
                <Icon name={group.icon} class="h-5 w-5" />
              </span>
              <Icon name="chevron-right" class="h-4 w-4 text-brand-400" />
            </div>
            <h3 class="mt-3 font-display text-base font-extrabold text-navy-950">{group.title}</h3>
            <p class="mt-1 text-[0.8rem] leading-relaxed text-navy-500">{group.body}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="chip !py-1 !text-[0.68rem]">{item}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <ExploreMore intro="See where these skills show up in shipped work, or explore my experience on the About page." />
</BaseLayout>
