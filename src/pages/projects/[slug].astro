---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const toc = [
  { id: 'overview', label: 'Overview', icon: 'eye' },
  { id: 'problem', label: 'Problem', icon: 'alert' },
  { id: 'role', label: 'My Role', icon: 'user' },
  { id: 'solution', label: 'Solution', icon: 'bulb' },
  ...(d.analysis ? [{ id: 'analysis', label: 'Live Analysis', icon: 'activity' }] : []),
  { id: 'workflow', label: 'Workflow', icon: 'workflow' },
  { id: 'features', label: 'Key Features', icon: 'check' },
  { id: 'stack', label: 'Tech Stack', icon: 'layers' },
  { id: 'value', label: 'Value', icon: 'zap' },
  { id: 'outcome', label: 'Outcome', icon: 'target' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: 'M Vinay Sagar' },
  dateCreated: d.year,
};
---

<BaseLayout title={d.title} description={d.summary} image={d.image} schema={schema}>
  <div class="mx-auto max-w-7xl px-5 pt-32 sm:px-8 md:pt-36">
    <div class="grid gap-8 lg:grid-cols-[13rem_1fr]">
      <!-- Sticky TOC -->
      <nav class="hidden lg:block" aria-label="On this page">
        <div class="sticky top-28">
          <p class="px-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-navy-400">On this Page</p>
          <ul class="mt-3 space-y-1 border-l-2 border-ice-200">
            {
              toc.map((item, i) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc-link={item.id}
                    class:list={[
                      'flex items-center gap-2.5 border-l-2 py-2 pl-3 -ml-0.5 text-[0.82rem] font-semibold transition',
                      i === 0
                        ? 'border-brand-500 bg-brand-50 text-brand-600'
                        : 'border-transparent text-navy-500 hover:border-brand-300 hover:text-brand-600',
                    ]}
                  >
                    <Icon name={item.icon} class="h-3.5 w-3.5" />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="card mt-6 !rounded-2xl p-4">
            <p class="flex items-center gap-2 text-[0.8rem] font-bold text-navy-800">
              <Icon name="send" class="h-4 w-4 text-brand-500" />
              Interested in similar work?
            </p>
            <a href="/contact" class="btn-primary mt-3 w-full !py-2 text-xs">Contact Me</a>
          </div>
        </div>
      </nav>

      <div>
        <!-- Header -->
        <div class="flex flex-wrap items-center gap-2.5" data-animate>
          <span class="chip !bg-white">
            <Icon name="home" class="h-3.5 w-3.5 text-brand-500" />
            Home › <a href="/projects" class="text-brand-600">Projects</a> › <span class="text-brand-600">{d.title}</span>
          </span>
          {
            d.nda && (
              <span class="chip !bg-navy-950 !border-navy-950 !text-white">
                <Icon name="lock" class="h-3.5 w-3.5" /> NDA Protected
              </span>
            )
          }
        </div>

        <div class="mt-5 grid gap-7 lg:grid-cols-[1.15fr_1fr] lg:items-start">
          <div>
            <h1 class="text-4xl font-extrabold leading-[1.05] sm:text-5xl" data-animate data-delay="0.05">
              {d.title}
            </h1>
            <p class="mt-4 leading-relaxed text-navy-500" data-animate data-delay="0.1">{d.summary}</p>

            <div class="mt-5 flex flex-wrap gap-2" data-animate data-delay="0.14">
              {
                d.features.slice(0, 4).map((feature) => (
                  <span class="chip !bg-white">
                    <Icon name="check" class="h-3.5 w-3.5 text-emerald-500" />
                    {feature}
                  </span>
                ))
              }
            </div>

            <div class="mt-6 flex flex-wrap gap-3" data-animate data-delay="0.18">
              {
                d.hero && (
                  <a href={d.hero} target="_blank" rel="noopener" class="btn-primary">
                    <Icon name="play" class="h-4 w-4" />
                    View Screens
                  </a>
                )
              }
              {
                d.externalUrl && (
                  <a href={d.externalUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <Icon name="external" class="h-4 w-4" />
                    {d.externalLabel ?? 'Open project'}
                  </a>
                )
              }
              <a href="/projects" class="btn-ghost"><Icon name="arrow-left" class="h-4 w-4 text-brand-600" /> Back to Projects</a>
              <a href="/contact" class="btn-ghost"><Icon name="send" class="h-4 w-4 text-brand-600" /> Contact Me</a>
            </div>
          </div>

          <!-- Hero visual -->
          <div class="relative" data-animate data-delay="0.12">
            <div class="card overflow-hidden !p-2.5">
              <img
                src={d.hero ?? d.image}
                alt={`${d.title} interface`}
                width="620"
                height="350"
                class="h-full w-full rounded-2xl object-cover"
                fetchpriority="high"
              />
            </div>
            {
              d.analysis?.slice(0, 2).map((a, i) => (
                <div
                  class="card absolute -right-4 z-20 hidden w-[13.5rem] p-3.5 xl:block"
                  style={`top:${1 + i * 5.25}rem;`}
                  data-float
                >
                  <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-aqua-400 text-white">
                    <Icon name={a.icon} class="h-4 w-4" />
                  </span>
                  <p class="mt-2 font-display text-[0.82rem] font-extrabold text-navy-950">{a.title}</p>
                  <p class="mt-0.5 line-clamp-3 text-[0.68rem] leading-snug text-navy-400">{a.detail}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Overview: problem / role / solution -->
        <section id="overview" class="mt-10 grid gap-4 md:grid-cols-3" data-animate data-animate-scroll>
          <article id="problem" class="card p-5">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-rose-50 text-rose-500">
              <Icon name="bug" class="h-5 w-5" />
            </span>
            <h2 class="mt-3 font-display text-lg font-extrabold">The Problem</h2>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{d.problem}</p>
          </article>
          <article id="role" class="card p-5">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="user" class="h-5 w-5" />
            </span>
            <h2 class="mt-3 font-display text-lg font-extrabold">My Role</h2>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{d.role}</p>
          </article>
          <article id="solution" class="card p-5">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-amber-50 text-amber-500">
              <Icon name="bulb" class="h-5 w-5" />
            </span>
            <h2 class="mt-3 font-display text-lg font-extrabold">The Solution</h2>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{d.solution}</p>
          </article>
        </section>

        <div class="mt-4 card p-6 text-sm leading-relaxed text-navy-600" data-animate data-animate-scroll>
          <Content />
        </div>

        <!-- Live analysis cards -->
        {
          d.analysis && (
            <section id="analysis" class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              {d.analysis.map((a) => (
                <article class="card card-hover p-5" data-animate data-animate-scroll>
                  <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-aqua-400 text-white">
                    <Icon name={a.icon} class="h-5 w-5" />
                  </span>
                  <h3 class="mt-3 font-display text-base font-extrabold text-navy-950">{a.title}</h3>
                  <p class="mt-1.5 text-[0.82rem] leading-relaxed text-navy-500">{a.detail}</p>
                </article>
              ))}
            </section>
          )
        }

        <!-- Workflow -->
        <section id="workflow" class="card mt-4 p-6" data-animate data-animate-scroll>
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="workflow" class="h-5 w-5" />
            </span>
            <div>
              <h2 class="font-display text-xl font-extrabold">Workflow</h2>
              <p class="text-sm text-navy-400">From problem to delivery, step by step.</p>
            </div>
          </div>

          <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {
              d.workflow.map((step, i) => (
                <li class="relative rounded-2xl border border-ice-100 bg-ice-50/70 p-4">
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-gradient-to-br from-brand-600 to-aqua-400 text-[0.7rem] font-bold text-white">
                    {i + 1}
                  </span>
                  <p class="mt-2 font-display text-[0.85rem] font-extrabold leading-tight text-navy-950">
                    {step.step}
                  </p>
                  <p class="mt-1 text-[0.72rem] leading-snug text-navy-400">{step.detail}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- Key features -->
        <section id="features" class="card mt-4 p-6" data-animate data-animate-scroll>
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="sparkles" class="h-5 w-5" />
            </span>
            <h2 class="font-display text-xl font-extrabold">Key Features</h2>
          </div>
          <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {
              d.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-navy-600">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600">
                    <Icon name="check" class="h-3 w-3" />
                  </span>
                  {feature}
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Tech stack -->
        <section id="stack" class="card mt-4 p-6" data-animate data-animate-scroll>
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="layers" class="h-5 w-5" />
            </span>
            <h2 class="font-display text-xl font-extrabold">Tech Stack</h2>
          </div>
          <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {
              d.techStack.map((tech) => (
                <li class="rounded-2xl border border-ice-100 bg-ice-50/70 p-4 text-center">
                  <span class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-white text-brand-600 shadow-sm">
                    <Icon name={tech.icon} class="h-5 w-5" />
                  </span>
                  <p class="mt-2 font-display text-[0.82rem] font-extrabold text-navy-950">{tech.name}</p>
                  <p class="text-[0.66rem] text-navy-400">{tech.role}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Value + outcome -->
        <section id="value" class="mt-4 grid gap-4 lg:grid-cols-[1.5fr_1fr]">
          <div class="card p-6" data-animate data-animate-scroll>
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name="zap" class="h-5 w-5" />
              </span>
              <h2 class="font-display text-xl font-extrabold">Engineering Value</h2>
            </div>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              {
                d.value.map((v) => (
                  <li class="rounded-2xl border border-ice-100 bg-gradient-to-b from-ice-50 to-white p-4">
                    <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-500 text-white">
                      <Icon name={v.icon} class="h-4 w-4" />
                    </span>
                    <p class="mt-2 font-display text-[0.86rem] font-extrabold text-navy-950">{v.label}</p>
                    <p class="text-[0.7rem] text-navy-400">{v.sub}</p>
                  </li>
                ))
              }
            </ul>
          </div>

          <div id="outcome" class="card flex flex-col justify-center bg-gradient-to-br from-navy-950 to-navy-800 p-6 text-white" data-animate data-animate-scroll>
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-aqua-400">
              <Icon name="target" class="h-5 w-5" />
            </span>
            <h2 class="mt-3 font-display text-xl font-extrabold text-white">Outcome</h2>
            <p class="mt-2 text-sm leading-relaxed text-navy-300">{d.outcome}</p>
            <a href="/contact" class="btn-primary mt-5 w-full !py-2.5 text-sm">
              <Icon name="send" class="h-4 w-4" />
              Discuss this kind of work
            </a>
          </div>
        </section>

        <!-- Prev / next -->
        <nav class="mt-8 flex items-center justify-between gap-4" aria-label="Project navigation">
          <a href="/projects" class="btn-ghost"><Icon name="arrow-left" class="h-4 w-4 text-brand-600" /> All projects</a>
          <a href="/contact" class="btn-primary">Work with me <Icon name="arrow-right" class="h-4 w-4" /></a>
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Highlight the current section in the sticky TOC.
  function setupToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (!links.length) return;
    const sections = links
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter((s): s is HTMLElement => Boolean(s));

    const setActive = (id: string) => {
      links.forEach((l) => {
        const on = l.dataset.tocLink === id;
        l.classList.toggle('bg-brand-50', on);
        l.classList.toggle('text-brand-600', on);
        l.classList.toggle('border-brand-500', on);
        l.classList.toggle('border-transparent', !on);
        l.classList.toggle('text-navy-500', !on);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible?.target.id) setActive(visible.target.id);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: 0 }
    );

    sections.forEach((s) => observer.observe(s));
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>
