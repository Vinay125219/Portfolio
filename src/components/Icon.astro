---
import { iconPaths } from '../data/icons';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
const inner = iconPaths[name] ?? iconPaths.cube;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
