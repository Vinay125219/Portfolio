---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, badge, year, impact, tags, image, nda } = project.data;
---

<article
  class="card card-hover group flex flex-col overflow-hidden"
  data-animate
  data-animate-scroll
  data-domains={project.data.domains.join(',')}
  data-tools={project.data.tools.join(',')}
  data-order={project.data.order}
  data-impact={impact}
>
  <a href={`/projects/${project.id}`} class="relative block overflow-hidden" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt=""
      width="411"
      height="145"
      loading="lazy"
      class="aspect-[411/145] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <span class="absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-white to-transparent opacity-0 transition group-hover:opacity-100"></span>
  </a>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <a href={`/projects/${project.id}`} class="font-display text-lg font-extrabold leading-snug text-navy-950">
        {title}
      </a>
      {
        nda && (
          <span class="chip shrink-0 !bg-navy-950 !text-white !border-navy-950 text-[0.65rem]">
            <Icon name="lock" class="h-3 w-3" />
            NDA
          </span>
        )
      }
    </div>

    <p class="text-sm leading-relaxed text-navy-500">{summary}</p>

    <div class="mt-auto flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="chip !py-1 !text-[0.7rem]">{tag}</span>
        ))
      }
    </div>

    <div class="mt-1 flex items-center justify-between border-t border-ice-100 pt-3">
      <span class="flex items-center gap-1.5 text-xs font-semibold text-navy-400">
        <Icon name="calendar" class="h-3.5 w-3.5" />
        {year}
      </span>
      <span class="flex items-center gap-1.5 text-xs font-semibold text-brand-600">
        <Icon name="chart" class="h-3.5 w-3.5" />
        {impact}
      </span>
      <a
        href={`/projects/${project.id}`}
        class="grid h-9 w-9 place-items-center rounded-full border border-ice-200 bg-white text-brand-600 transition group-hover:border-brand-400 group-hover:bg-brand-500 group-hover:text-white"
        aria-label={`Open case study: ${title}`}
      >
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
  <span class="sr-only">{badge}</span>
</article>
