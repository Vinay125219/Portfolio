---
// AboutSection.astro
---

<section id="about" class="w-full py-12 md:py-16 border-t border-token/40">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-token pb-6 reveal-on-scroll">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-accent">Profile</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-token-primary tracking-tight">
          About Vinay Sagar
        </h2>
      </div>
      <p class="text-sm text-token-secondary max-w-md">
        A developer with a practical engineering base: UI migration, desktop tools, data visualization, and careful product interfaces.
      </p>
    </div>

    <!-- Main Content Layout (Photo + Bio) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Photo & Quick Facts (5 Cols) -->
      <div class="lg:col-span-5 space-y-6 reveal-on-scroll">
        <div class="relative max-w-sm mx-auto lg:max-w-none">
          <div class="rounded-3xl overflow-hidden border-2 border-token shadow-2xl bg-surface-elevated">
            <img
              src="/assets/images/Profile_Pic.png"
              alt="M Vinay Sagar - Software Engineer"
              class="w-full h-auto object-cover max-h-[420px]"
            />
          </div>
          <!-- Corner Floating Status Badge -->
          <div class="absolute -bottom-4 -right-4 p-4 rounded-xl bg-surface border border-token shadow-xl flex items-center gap-3 animate-float">
            <span class="w-3 h-3 rounded-full bg-success animate-ping"></span>
            <div>
              <span class="block text-xs font-bold text-token-primary">Currently at DRDL</span>
              <span class="block text-[11px] text-token-muted">Contract Engineer</span>
            </div>
          </div>
        </div>

        <!-- 4 Compact Facts Grid -->
        <div class="grid grid-cols-2 gap-3 pt-4">
          <div class="p-3.5 rounded-xl bg-surface border border-token text-left space-y-1">
            <span class="block text-xs text-token-muted font-semibold uppercase">Location</span>
            <span class="text-xs font-bold text-token-primary">Hyderabad, India</span>
          </div>
          <div class="p-3.5 rounded-xl bg-surface border border-token text-left space-y-1">
            <span class="block text-xs text-token-muted font-semibold uppercase">Focus</span>
            <span class="text-xs font-bold text-token-primary">Qt, Python, Flutter</span>
          </div>
          <div class="p-3.5 rounded-xl bg-surface border border-token text-left space-y-1">
            <span class="block text-xs text-token-muted font-semibold uppercase">Core Role</span>
            <span class="text-xs font-bold text-token-primary">Contract Engineer</span>
          </div>
          <div class="p-3.5 rounded-xl bg-surface border border-token text-left space-y-1">
            <span class="block text-xs text-token-muted font-semibold uppercase">Education</span>
            <span class="text-xs font-bold text-token-primary">B.Tech ECE (GPA 7.2)</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Bio Paragraphs & Social Links (7 Cols) -->
      <div class="lg:col-span-7 space-y-6 text-left reveal-on-scroll delay-150">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-token-primary tracking-tight">
          I like interfaces that make technical work easier to see and act on.
        </h3>

        <div class="space-y-4 text-base text-token-secondary leading-relaxed">
          <p>
            I’m M Vinay Sagar, based in Hyderabad. My current work at DRDL involves UI migration, QML layout enhancement, C++ front-end integration, and visualization of bus-monitoring data for engineering analysis.
          </p>
          <p>
            Outside the role, I build practical app prototypes and desktop utilities: school operations screens, income tracking, notes, checklist generation, code comparison, and offline Python package tooling.
          </p>
        </div>

        <!-- Action Links & Resume Download -->
        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-token/60">
          <a
            href="/assets/Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="active-press inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-xl bg-accent text-white hover:bg-accent-hover transition-colors shadow-sm"
          >
            <span>Download Full Résumé</span>
            <span class="ml-2">↓</span>
          </a>

          <a
            href="https://github.com/Vinay125219"
            target="_blank"
            rel="noopener noreferrer"
            class="active-press inline-flex items-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl bg-surface-elevated hover:bg-surface-hover text-token-primary border border-token transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            <span>GitHub</span>
          </a>

          <a
            href="https://www.linkedin.com/in/vinay-sagar-659b551b4/"
            target="_blank"
            rel="noopener noreferrer"
            class="active-press inline-flex items-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl bg-surface-elevated hover:bg-surface-hover text-token-primary border border-token transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
