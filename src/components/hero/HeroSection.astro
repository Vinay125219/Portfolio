---
// HeroSection.astro
---

<section id="hero" class="relative w-full pt-8 pb-12 md:pt-12 md:pb-16 overflow-hidden">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs (7 Cols) -->
      <div class="lg:col-span-6 space-y-6 text-left reveal-on-scroll">
        <!-- Primary Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-token-primary leading-[1.08]">
          M Vinay Sagar builds <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-indigo-400 to-cyan-500">
            engineering interfaces.
          </span>
        </h1>

        <!-- Supporting Copy -->
        <p class="text-base sm:text-lg text-token-secondary leading-relaxed max-w-xl">
          Software Engineer in Hyderabad working across Qt/QML, C++, Python, Flutter, Firebase, Supabase, and AI-assisted product workflows.
        </p>

        <!-- CTA Action Group with Emil Kowalski Active Scale Feedback -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#work"
            class="active-press inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-xl bg-accent text-white hover:bg-accent-hover transition-all shadow-lg hover:shadow-glow group"
          >
            <span>View Work</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="/assets/Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="active-press inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-xl bg-surface-elevated hover:bg-surface-hover text-token-primary border border-token transition-colors"
          >
            <svg class="w-4 h-4 mr-2 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download Résumé</span>
          </a>
        </div>

        <!-- Compact Proof Strip -->
        <div class="grid grid-cols-3 gap-3 pt-5 border-t border-token/60 max-w-xl">
          <div class="p-3 rounded-lg bg-surface/50 border border-token/40">
            <span class="block text-lg sm:text-xl font-extrabold text-token-primary font-mono">DRDL</span>
            <span class="text-[11px] text-token-muted font-medium">Contract Engineer</span>
          </div>
          <div class="p-3 rounded-lg bg-surface/50 border border-token/40">
            <span class="block text-lg sm:text-xl font-extrabold text-token-primary font-mono">Qt/QML</span>
            <span class="text-[11px] text-token-muted font-medium">UI Migration</span>
          </div>
          <div class="p-3 rounded-lg bg-surface/50 border border-token/40">
            <span class="block text-lg sm:text-xl font-extrabold text-token-primary font-mono">Flutter</span>
            <span class="text-[11px] text-token-muted font-medium">Android/iOS</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Live Product Simulator (5 Cols) -->
      <div class="lg:col-span-6 relative reveal-on-scroll delay-150" id="heroVisualContainer">
        
        <!-- Interactive Product Simulator Frame -->
        <div class="relative mx-auto max-w-xl lg:max-w-none rounded-2xl bg-surface border border-token p-3 shadow-2xl space-y-3">
          
          <!-- Top Segmented Controls Tab Toolbar -->
          <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface-elevated border border-token overflow-x-auto" id="simulatorTabs">
            <button
              type="button"
              data-sim-tab="drdl"
              class="active-press flex-1 py-1.5 px-2.5 text-[11px] font-semibold rounded-lg bg-accent text-white shadow-sm transition-all whitespace-nowrap"
            >
              DRDL Tool
            </button>
            <button
              type="button"
              data-sim-tab="focustoday"
              class="active-press flex-1 py-1.5 px-2.5 text-[11px] font-semibold rounded-lg text-token-secondary hover:text-token-primary transition-all whitespace-nowrap"
            >
              FocusToday
            </button>
            <button
              type="button"
              data-sim-tab="spendscanner"
              class="active-press flex-1 py-1.5 px-2.5 text-[11px] font-semibold rounded-lg text-token-secondary hover:text-token-primary transition-all whitespace-nowrap"
            >
              SpendScanner
            </button>
            <button
              type="button"
              data-sim-tab="notiva"
              class="active-press flex-1 py-1.5 px-2.5 text-[11px] font-semibold rounded-lg text-token-secondary hover:text-token-primary transition-all whitespace-nowrap"
            >
              Notiva
            </button>
          </div>

          <!-- Browser / App View Window Frame -->
          <div class="relative rounded-2xl overflow-hidden border border-token bg-surface-elevated aspect-[4/3] group">
            
            <!-- Window Bar -->
            <div class="px-3 py-2 bg-surface border-b border-token flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
              </div>
              <span id="simUrl" class="text-[10px] font-mono text-token-muted truncate max-w-[180px]">drdl.local/analysis</span>
              <span id="simTag" class="text-[9px] px-2 py-0.5 rounded-full bg-accent/10 text-accent font-semibold">Python · Qt/QML</span>
            </div>

            <!-- Dynamic Image Frame -->
            <img
              id="simImage"
              src="/assets/images/Data_Analysis_Application.png"
              alt="Interactive Application Simulator Window"
              class="w-full h-full object-cover transition-opacity duration-300"
            />

            <!-- Interactive Info Overlay Overlay -->
            <div class="absolute bottom-0 inset-x-0 p-3 bg-gradient-to-t from-black/90 via-black/60 to-transparent text-white space-y-1">
              <h4 id="simTitle" class="text-sm font-bold truncate">DRDL Data Analysis Application</h4>
              <p id="simDesc" class="text-[11px] text-gray-200 line-clamp-1">CSV bus-monitoring data, parameter plots, and review workflows.</p>
            </div>
          </div>

          <!-- Interactive Sim Metadata Footer -->
          <div class="flex items-center justify-between text-[11px] text-token-muted pt-1">
            <span id="simMetric" class="font-mono text-accent font-semibold">QML + C++ integration</span>
            <button
              type="button"
              id="simInspectBtn"
              data-open-project="drdl-data-analysis"
              class="active-press font-semibold text-token-primary hover:text-accent flex items-center gap-1 transition-colors"
            >
              Inspect Case Study
            </button>
          </div>

          <!-- Ambient Floating Floating Badges -->
          <div class="absolute -top-5 -right-4 p-2.5 rounded-xl bg-surface border border-token shadow-xl hidden md:flex items-center gap-2 animate-float pointer-events-none">
            <span class="w-2 h-2 rounded-full bg-success"></span>
            <span class="text-[11px] font-bold text-token-primary">QML Migration</span>
          </div>

          <div class="absolute -bottom-5 -left-4 p-2.5 rounded-xl bg-surface border border-token shadow-xl hidden sm:flex items-center gap-2 animate-float-reverse pointer-events-none">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-[11px] font-bold text-token-primary">Python Plots</span>
          </div>

        </div>
      </div>

    </div>

    <!-- Scroll Indicator -->
    <div class="flex justify-center pt-10">
      <a href="#work" class="active-press flex flex-col items-center gap-2 text-token-muted hover:text-accent transition-colors group">
        <span class="text-xs font-medium tracking-wider uppercase">More work</span>
        <svg class="w-4 h-4 group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 5v14M19 12l-7 7-7-7"></path>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  import { initMotionObserver } from '../../scripts/motion';

  // Live Simulator Data Mapping
  const SIM_DATA: Record<string, {
    url: string;
    tag: string;
    image: string;
    title: string;
    desc: string;
    metric: string;
    id: string;
  }> = {
    drdl: {
      url: 'drdl.local/analysis',
      tag: 'Python · Qt/QML',
      image: '/assets/images/Data_Analysis_Application.png',
      title: 'DRDL Data Analysis Application',
      desc: 'CSV bus-monitoring data, parameter plots, and review workflows.',
      metric: 'QML + C++ integration',
      id: 'drdl-data-analysis'
    },
    focustoday: {
      url: 'focustoday.app/feed',
      tag: 'Flutter · Firebase',
      image: '/assets/images/project-placeholder-mobile.svg',
      title: 'FocusToday News & Media',
      desc: 'Android and iOS media browsing experience built with Flutter.',
      metric: 'Cross-platform content app',
      id: 'focustoday'
    },
    spendscanner: {
      url: 'spendscanner.app/ledger',
      tag: 'Flutter · Dart',
      image: '/assets/images/Income_tracker_1.png',
      title: 'SpendScanner',
      desc: 'Manual expense recording and privacy-focused personal finance tracking.',
      metric: 'Manual tracking + charts',
      id: 'spendscanr'
    },
    notiva: {
      url: 'notiva.app/voice',
      tag: 'Flutter · AI',
      image: '/assets/images/project-placeholder-mobile.svg',
      title: 'Notiva AI Voice Notes',
      desc: 'AI transcription, automatic organization, sharing, and privacy-focused flows.',
      metric: 'Voice capture + AI transcription',
      id: 'notiva'
    }
  };

  const simTabs = document.querySelectorAll<HTMLButtonElement>('[data-sim-tab]');
  const simUrl = document.getElementById('simUrl');
  const simTag = document.getElementById('simTag');
  const simImage = document.getElementById('simImage') as HTMLImageElement | null;
  const simTitle = document.getElementById('simTitle');
  const simDesc = document.getElementById('simDesc');
  const simMetric = document.getElementById('simMetric');
  const simInspectBtn = document.getElementById('simInspectBtn');

  simTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const key = tab.getAttribute('data-sim-tab') || 'schooldesk';
      const data = SIM_DATA[key];
      if (!data) return;

      // Update Tab Styles
      simTabs.forEach(t => {
        t.classList.remove('bg-accent', 'text-white', 'shadow-sm');
        t.classList.add('text-token-secondary');
      });
      tab.classList.add('bg-accent', 'text-white', 'shadow-sm');
      tab.classList.remove('text-token-secondary');

      // Morph Content
      if (simImage) {
        simImage.style.opacity = '0.3';
        setTimeout(() => {
          simImage.src = data.image;
          simImage.style.opacity = '1';
        }, 150);
      }

      if (simUrl) simUrl.textContent = data.url;
      if (simTag) simTag.textContent = data.tag;
      if (simTitle) simTitle.textContent = data.title;
      if (simDesc) simDesc.textContent = data.desc;
      if (simMetric) simMetric.textContent = data.metric;
      if (simInspectBtn) simInspectBtn.setAttribute('data-open-project', data.id);
    });
  });

  // Init Motion Observers
  initMotionObserver();
</script>
