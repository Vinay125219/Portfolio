---
// ProjectExplorer.astro
import { PROJECTS } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';

const categories = [
  'All',
  'Mobile',
  'Web',
  'SaaS',
  'Desktop',
  'Android',
  'iOS',
  'AI-Assisted',
  'Media',
  'Productivity',
  'Business Tools',
  'Dev Tools'
];
---

<section id="projects" class="w-full py-16 md:py-24 border-t border-token/40">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-token pb-6 reveal-on-scroll">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-accent">Complete Portfolio</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-token-primary tracking-tight">
          All Projects
        </h2>
      </div>
      <p class="text-sm text-token-secondary max-w-md">
        Explore mobile apps, desktop tools, data telemetry utilities, SaaS systems, and digital workflow platforms.
      </p>
    </div>

    <!-- Filter Buttons Toolbar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none reveal-on-scroll delay-100" role="tablist" aria-label="Project Categories">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-filter-btn={cat}
          aria-pressed={idx === 0 ? "true" : "false"}
          class={`active-press whitespace-nowrap px-4 py-2 text-xs font-semibold rounded-xl transition-all focus:outline-none ${
            idx === 0
              ? 'bg-accent text-white shadow-sm'
              : 'bg-surface-elevated text-token-secondary hover:text-token-primary border border-token'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Project Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="projectsGrid">
      {PROJECTS.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

  </div>
</section>

<script>
  import { initProjectFilters } from '../../scripts/filters';
  initProjectFilters();
</script>
