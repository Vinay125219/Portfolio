---
import { navLinks, profile } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const clean = href.replace(/\/$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(clean + '/');
}
---

<header class="fixed inset-x-0 top-0 z-50 px-3 sm:px-6" data-nav>
  <div
    class="mx-auto mt-4 flex max-w-7xl items-center gap-3 rounded-[26px] border border-white/80 bg-white/85 px-3 py-2.5 shadow-[0_18px_45px_-26px_rgba(13,60,140,0.5)] backdrop-blur-xl sm:px-5"
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Vinay Sagar — home">
      <span
        class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand-600 to-aqua-400 font-display text-xl font-extrabold text-white shadow-[0_10px_22px_-10px_rgba(29,110,245,0.8)]"
      >
        V
      </span>
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="font-display text-[1.05rem] font-extrabold text-navy-950">Vinay Sagar</span>
        <span class="text-[0.68rem] font-medium text-navy-400">Engineer • Builder • Problem Solver</span>
      </span>
    </a>

    <nav class="mx-auto hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'relative px-3.5 py-2 text-[0.9rem] font-semibold transition-colors',
                active ? 'text-brand-600' : 'text-navy-700 hover:text-brand-600',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
              {active && (
                <span class="dot-glow absolute -bottom-0.5 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rounded-full bg-brand-500" />
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a href="/contact" class="btn-primary hidden !px-5 !py-2.5 text-sm sm:inline-flex">
        <Icon name="send" class="h-4 w-4" />
        Get in Touch
      </a>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-xl border border-ice-200 bg-white text-navy-800 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" class="h-5 w-5" data-menu-icon />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mx-auto mt-2 hidden max-w-7xl rounded-3xl border border-ice-200 bg-white/95 p-3 shadow-[0_24px_50px_-30px_rgba(13,60,140,0.6)] backdrop-blur-xl lg:hidden"
    data-menu
  >
    <ul class="grid grid-cols-2 gap-1.5">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold transition',
                  active ? 'bg-brand-50 text-brand-600' : 'text-navy-700 hover:bg-ice-50',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
                {active && <span class="h-1.5 w-1.5 rounded-full bg-brand-500" />}
              </a>
            </li>
          );
        })
      }
    </ul>
    <a href="/contact" class="btn-primary mt-3 w-full">
      <Icon name="send" class="h-4 w-4" />
      Get in Touch
    </a>
  </div>
</header>

<script>
  function setupMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!toggle || !menu || toggle.dataset.bound === '1') return;
    toggle.dataset.bound = '1';
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>

<span class="sr-only">{profile.role}</span>
