---
// ProductProcess.astro
const processSteps = [
  {
    step: "01",
    title: "Understand the Workflow",
    summary: "Map the user, data source, screens, and exact action the tool needs to support."
  },
  {
    step: "02",
    title: "Shape the Interface",
    summary: "Design the smallest clear screen system: inputs, states, charts, and review paths."
  },
  {
    step: "03",
    title: "Build the Tool",
    summary: "Implement with Qt/QML, C++, Python, Flutter, or Astro depending on the product surface."
  },
  {
    step: "04",
    title: "Verify and Refine",
    summary: "Test the workflow with real files, edge cases, responsive layouts, and user feedback."
  }
];
---

<section id="process" class="w-full py-12 md:py-16 border-t border-token/40">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-token pb-6 reveal-on-scroll">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-accent">Process</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-token-primary tracking-tight">
          How I build
        </h2>
      </div>
      <p class="text-sm text-token-secondary max-w-md">
        Simple enough to follow, structured enough to ship useful software.
      </p>
    </div>

    <!-- Visual Process Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {processSteps.map((item, idx) => (
        <div class={`relative p-5 rounded-xl bg-surface border border-token shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-4 group reveal-on-scroll ${idx > 1 ? 'delay-150' : 'delay-100'}`}>
          <div class="space-y-3">
            <span class="text-2xl font-mono font-extrabold text-accent/40 group-hover:text-accent transition-colors">
              {item.step}
            </span>
            <h3 class="text-base font-bold text-token-primary leading-snug">
              {item.title}
            </h3>
            <p class="text-xs text-token-secondary leading-relaxed">
              {item.summary}
            </p>
          </div>
          <div class="pt-2 border-t border-token/30 flex items-center justify-between text-[11px] text-token-muted">
            <span>Stage {item.step}</span>
            <span class="text-accent group-hover:translate-x-1 transition-transform">-&gt;</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
