<div class="hero-portrait relative isolate mx-auto aspect-square w-full max-w-[26rem]" data-portrait>
  <div class="portrait-halo absolute inset-8 -z-10 rounded-full bg-brand-300/25 blur-2xl" aria-hidden="true"></div>

  <svg class="portrait-signals pointer-events-none absolute inset-0 h-full w-full text-brand-500" viewBox="0 0 440 440" fill="none" aria-hidden="true">
    <circle cx="220" cy="220" r="210" stroke="currentColor" stroke-opacity="0.12" />
    <circle class="signal-track" cx="220" cy="220" r="210" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="3 17" />
    <g class="signal-orbit">
      <circle cx="220" cy="10" r="6" fill="#1d6ef5" />
      <circle cx="220" cy="10" r="12" stroke="#1d6ef5" stroke-opacity="0.2" />
      <circle cx="220" cy="430" r="4" fill="#29c6f6" />
    </g>
    <g class="signal-orbit signal-orbit-reverse">
      <circle cx="10" cy="220" r="4" fill="#29c6f6" />
      <circle cx="430" cy="220" r="5" fill="#1d6ef5" />
    </g>
    <path d="M14 68V32a18 18 0 0 1 18-18h36M372 14h36a18 18 0 0 1 18 18v36M426 372v36a18 18 0 0 1-18 18h-36M68 426H32a18 18 0 0 1-18-18v-36" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.5" />
  </svg>

  <div class="portrait-surface absolute inset-5 overflow-hidden rounded-[2.5rem] border border-white bg-ice-50 shadow-[0_40px_80px_-50px_rgba(13,60,140,0.7)]">
    <img
      src="/images/profile.webp"
      alt="Portrait of M Vinay Sagar"
      width="1000"
      height="1000"
      class="h-full w-full object-cover object-top"
      fetchpriority="high"
    />
  </div>
</div>

<style>
  .portrait-surface {
    transform: perspective(900px) rotateX(var(--portrait-x, 0deg)) rotateY(var(--portrait-y, 0deg));
    transition: transform 350ms ease-out;
  }

  .signal-orbit {
    transform-origin: 220px 220px;
    animation: orbit 24s linear infinite;
  }

  .signal-orbit-reverse {
    animation-direction: reverse;
    animation-duration: 32s;
  }

  .signal-track {
    animation: signal-flow 12s linear infinite;
  }

  .portrait-halo {
    animation: halo-breathe 6s ease-in-out infinite alternate;
  }

  @keyframes orbit {
    to { transform: rotate(360deg); }
  }

  @keyframes signal-flow {
    to { stroke-dashoffset: -100; }
  }

  @keyframes halo-breathe {
    to { transform: scale(1.12); opacity: 0.55; }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-orbit, .signal-track, .portrait-halo { animation: none; }
    .portrait-surface { transform: none; transition: none; }
  }
</style>

<script>
  let cleanupPortrait = () => {};

  function setupPortrait() {
    cleanupPortrait();
    const portrait = document.querySelector<HTMLElement>('[data-portrait]');
    if (!portrait) return;

    const controller = new AbortController();
    const motion = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    const reset = () => {
      portrait.style.removeProperty('--portrait-x');
      portrait.style.removeProperty('--portrait-y');
    };

    portrait.addEventListener('pointermove', (event) => {
      if (!motion.matches) return;
      const bounds = portrait.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      portrait.style.setProperty('--portrait-x', `${-y * 6}deg`);
      portrait.style.setProperty('--portrait-y', `${x * 6}deg`);
    }, { signal: controller.signal });
    portrait.addEventListener('pointerleave', reset, { signal: controller.signal });
    motion.addEventListener('change', reset, { signal: controller.signal });

    cleanupPortrait = () => { controller.abort(); reset(); };
  }

  setupPortrait();
  document.addEventListener('astro:page-load', setupPortrait);
  document.addEventListener('astro:before-swap', () => cleanupPortrait());
</script>
