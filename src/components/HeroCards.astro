---
import Icon from './Icon.astro';
import { heroCards } from '../data/site';
---

<ul class="relative mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2" aria-label="Explore my engineering work">
  {heroCards.map((card) => (
    <li class="min-w-0">
      <a href={card.href} class="feature-card" data-feature-card data-motion={card.motion}>
        <span class="feature-content flex items-start gap-2.5">
          <span class="feature-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-aqua-400 text-white">
            <Icon name={card.icon} class="h-4 w-4" />
          </span>
          <span class="min-w-0">
            <span class="block font-display text-[0.82rem] font-extrabold leading-tight text-navy-950">{card.title}</span>
            <span class="mt-1 block text-xs leading-relaxed text-navy-500">{card.body}</span>
          </span>
        </span>
        <span class="feature-footer">
          <span class="feature-action">{card.action}<Icon name="arrow-right" class="feature-arrow h-3.5 w-3.5 shrink-0" /></span>
          <svg class="feature-preview" viewBox="0 0 56 24" fill="none" aria-hidden="true">
            {card.motion === 'chart' ? (
              <g fill="currentColor"><rect class="mini-bar" x="4" y="13" width="7" height="9" rx="2" /><rect class="mini-bar" x="17" y="7" width="7" height="15" rx="2" /><rect class="mini-bar" x="30" y="10" width="7" height="12" rx="2" /><rect class="mini-bar" x="43" y="2" width="7" height="20" rx="2" /></g>
            ) : card.motion === 'signal' ? (
              <><path d="M1 17h9l6-12 9 17 9-17 7 12h14" stroke="currentColor" stroke-opacity="0.25" stroke-width="2" /><path class="mini-signal" d="M1 17h9l6-12 9 17 9-17 7 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></>
            ) : card.motion === 'interface' ? (
              <><rect x="3" y="2" width="50" height="20" rx="4" stroke="currentColor" stroke-opacity="0.4" /><path d="M3 8h50" stroke="currentColor" stroke-opacity="0.4" /><rect class="mini-panel" x="8" y="12" width="12" height="6" rx="2" fill="currentColor" /><rect class="mini-panel" x="24" y="12" width="24" height="6" rx="2" fill="currentColor" fill-opacity="0.35" /></>
            ) : (
              <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path class="mini-code" d="m17 6-8 6 8 6m22-12 8 6-8 6M31 3l-6 18" /></g>
            )}
          </svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .feature-card {
    position: relative;
    isolation: isolate;
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid #e1edfc;
    border-radius: 1.5rem;
    background: white;
    box-shadow: 0 18px 45px -28px rgb(13 60 140 / 25%);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }
  .feature-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0;
    background: radial-gradient(circle at var(--spot-x, 50%) var(--spot-y, 50%), #d4f3fe 0%, #ecf4ff 35%, white 80%);
    transition: opacity 220ms ease;
  }
  .feature-card:focus-visible { outline: 3px solid #1661ef; outline-offset: 3px; }
  .feature-card:focus-visible::before { opacity: 1; }
  .feature-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: auto; }
  .feature-action { display: flex; align-items: center; gap: 0.3rem; color: #0f4fd8; font-size: 0.65rem; font-weight: 700; }
  .feature-arrow, .feature-icon { transition: transform 250ms ease; }
  .feature-preview { width: 3rem; height: 1.5rem; flex-shrink: 0; color: #17a4d1; }
  .mini-bar { transform-box: fill-box; transform-origin: bottom; }
  .mini-bar:nth-child(2) { animation-delay: -0.3s; }
  .mini-bar:nth-child(3) { animation-delay: -0.6s; }
  .mini-bar:nth-child(4) { animation-delay: -0.9s; }
  .mini-signal { stroke-dasharray: 20 80; }
  .feature-card:is(:hover, :focus-visible) .mini-bar { animation-name: mini-bars; animation-duration: 900ms; animation-timing-function: ease-in-out; animation-iteration-count: infinite; animation-direction: alternate; }
  .feature-card:is(:hover, :focus-visible) .mini-signal { animation: mini-flow 1.5s linear infinite; }
  .feature-card:is(:hover, :focus-visible) .mini-panel { animation: mini-panels 1s ease-in-out infinite alternate; }
  .feature-card:is(:hover, :focus-visible) .mini-code { animation: mini-panels 1s ease-in-out infinite alternate; }
  .feature-card:focus-visible .feature-arrow { transform: translateX(3px); }
  .feature-card:active { transform: scale(0.98); border-color: #74acff; }
  @media (hover: hover) and (pointer: fine) {
    .feature-card:hover { transform: translateY(-3px); border-color: #74acff; box-shadow: 0 22px 40px -24px rgb(29 110 245 / 45%); }
    .feature-card:hover::before { opacity: 1; }
    .feature-card:hover .feature-icon { transform: translateY(-2px) rotate(-7deg); }
    .feature-card[data-motion='build']:hover .feature-icon { transform: rotate(90deg); }
    .feature-card:hover .feature-arrow { transform: translateX(3px); }
  }
  @keyframes mini-bars { to { transform: scaleY(0.45); } }
  @keyframes mini-flow { to { stroke-dashoffset: -100; } }
  @keyframes mini-panels { to { opacity: 0.5; transform: translateX(3px); } }
  @media (prefers-reduced-motion: reduce) {
    .feature-card, .feature-arrow, .feature-icon, .feature-card::before { transition: none; }
    .feature-card:is(:hover, :active), .feature-card:is(:hover, :focus-visible) .feature-icon, .feature-card:is(:hover, :focus-visible) .feature-arrow { transform: none; }
    .feature-card:is(:hover, :focus-visible) :is(.mini-bar, .mini-signal, .mini-panel, .mini-code) { animation: none; }
  }
</style>

<script>
  function setupCardSpotlights() {
    document.querySelectorAll<HTMLElement>('[data-feature-card]').forEach((card) => {
      if (card.dataset.bound) return;
      card.dataset.bound = 'true';
      card.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const bounds = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', `${event.clientX - bounds.left}px`);
        card.style.setProperty('--spot-y', `${event.clientY - bounds.top}px`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--spot-x');
        card.style.removeProperty('--spot-y');
      });
    });
  }
  setupCardSpotlights();
  document.addEventListener('astro:page-load', setupCardSpotlights);
</script>
