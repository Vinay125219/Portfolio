---
// Navigation.astro
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Work', href: '#work' },
  { label: 'Projects', href: '#projects' },
  { label: 'Capabilities', href: '#capabilities' },
  { label: 'Journey', href: '#journey' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  id="mainHeader"
  class="sticky top-0 z-40 w-full transition-all duration-300 glass-header border-b border-transparent"
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Monogram -->
    <a
      href="#hero"
      class="flex items-center gap-3 group focus:outline-none"
      aria-label="Vinay Sagar - Home"
    >
      <div
        class="w-9 h-9 rounded-xl bg-accent text-white font-extrabold flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition-transform"
      >
        VS
      </div>
      <div class="hidden sm:flex flex-col">
        <span class="font-bold text-sm tracking-tight text-token-primary group-hover:text-accent transition-colors">
          Vinay Sagar
        </span>
        <span class="text-[11px] text-token-muted font-medium tracking-wide">
          Contract Engineer
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 bg-surface-elevated/70 p-1 rounded-full border border-token">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="px-4 py-1.5 text-xs font-medium text-token-secondary hover:text-token-primary rounded-full transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Header Actions (Theme & CTA & Mobile Toggle) -->
    <div class="flex items-center gap-3">
      <ThemeToggle />

      <a
        href="#contact"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors shadow-sm focus:outline-none"
      >
        Let's Talk
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobileMenuBtn"
        type="button"
        class="md:hidden p-2 rounded-lg bg-surface-elevated hover:bg-surface-hover text-token-primary border border-token focus:outline-none"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <svg id="hamburgerIcon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
        <svg id="closeMenuIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobileDrawer"
    class="hidden md:hidden fixed inset-x-0 top-16 bg-surface/95 backdrop-blur-xl border-b border-token p-6 space-y-4 shadow-xl z-40"
    role="dialog"
    aria-label="Mobile Navigation"
  >
    <nav class="flex flex-col space-y-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link-mobile
            class="px-4 py-3 text-sm font-medium text-token-primary hover:bg-surface-elevated rounded-xl transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="pt-4 border-t border-token flex flex-col gap-3">
      <a
        href="#contact"
        data-nav-link-mobile
        class="w-full py-3 text-center text-sm font-semibold rounded-xl bg-accent text-white hover:bg-accent-hover transition-colors shadow-sm"
      >
        Let's Talk
      </a>
    </div>
  </div>
</header>

<script>
  import { initScrollSpy } from '../../scripts/scrollspy';

  const header = document.getElementById('mainHeader');
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeMenuIcon = document.getElementById('closeMenuIcon');

  // Add border on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('border-token', 'shadow-sm');
      header?.classList.remove('border-transparent');
    } else {
      header?.classList.remove('border-token', 'shadow-sm');
      header?.classList.add('border-transparent');
    }
  }, { passive: true });

  // Mobile Drawer Toggle
  function toggleMobileMenu() {
    const isExpanded = mobileMenuBtn?.getAttribute('aria-expanded') === 'true';
    mobileMenuBtn?.setAttribute('aria-expanded', String(!isExpanded));

    mobileDrawer?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeMenuIcon?.classList.toggle('hidden');

    if (!isExpanded) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }

  mobileMenuBtn?.addEventListener('click', toggleMobileMenu);

  // Close mobile menu on link selection
  document.querySelectorAll('[data-nav-link-mobile]').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenuBtn?.getAttribute('aria-expanded') === 'true') {
        toggleMobileMenu();
      }
    });
  });

  // Init scroll spy
  initScrollSpy();
</script>
