---
// ExperienceJourney.astro
import { EXPERIENCE_TIMELINE } from '../../data/experience';
---

<section id="journey" class="w-full py-12 md:py-16 border-t border-token/40">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-token pb-6 reveal-on-scroll">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-accent">Resume Timeline</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-token-primary tracking-tight">
          Experience & education
        </h2>
      </div>
      <p class="text-sm text-token-secondary max-w-md">
        The corrected timeline from the supplied resume, kept compact for quick scanning.
      </p>
    </div>

    <!-- Timeline List -->
    <div class="relative border-l-2 border-token/60 ml-4 sm:ml-6 pl-6 sm:pl-8 space-y-5">
      {EXPERIENCE_TIMELINE.map((item, idx) => (
        <div class={`relative group reveal-on-scroll ${idx % 2 === 1 ? 'delay-150' : 'delay-100'}`}>
          <!-- Timeline Node Dot -->
          <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-surface border-2 border-accent group-hover:scale-125 group-hover:bg-accent transition-all shadow-sm"></span>

          <div class="p-5 rounded-xl bg-surface border border-token shadow-sm hover:shadow-md transition-shadow space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-token/40 pb-3">
              <div>
                <h3 class="text-lg font-extrabold text-token-primary">{item.role}</h3>
                <span class="text-xs font-semibold text-accent">{item.organization}</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 text-xs font-mono rounded-full bg-surface-elevated text-token-secondary border border-token">
                  {item.period}
                </span>
                <span class="text-xs text-token-muted font-medium hidden sm:inline">{item.location}</span>
              </div>
            </div>

            <p class="text-sm text-token-secondary leading-relaxed">
              {item.summary}
            </p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
              {item.keyAchievements.slice(0, 2).map(ach => (
                <div class="rounded-lg bg-surface-elevated border border-token/40 p-3 text-xs sm:text-sm text-token-secondary">
                  {ach}
                </div>
              ))}
            </div>

            <div class="flex flex-wrap gap-1.5">
              {item.techUsed.slice(0, 5).map(t => (
                <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface-elevated text-token-muted border border-token/40">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
