---
/**
 * Soft abstract background shapes used across pages (pale blue + peach flows).
 */
interface Props {
  tone?: 'default' | 'warm';
}

const { tone = 'default' } = Astro.props;
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <div
    class="absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle_at_center,rgba(147,197,253,0.55),rgba(255,255,255,0))] blur-2xl"
  >
  </div>
  <div
    class="absolute -left-48 top-[38%] h-[30rem] w-[30rem] rounded-full bg-[radial-gradient(circle_at_center,rgba(255,214,180,0.4),rgba(255,255,255,0))] blur-2xl"
    data-float
  >
  </div>
  <div
    class="absolute -bottom-56 right-[8%] h-[36rem] w-[36rem] rounded-full bg-[radial-gradient(circle_at_center,rgba(165,243,252,0.45),rgba(255,255,255,0))] blur-2xl"
    data-float
  >
  </div>
  {
    tone === 'warm' && (
      <div class="absolute left-[30%] top-[10%] h-72 w-72 rounded-full bg-[radial-gradient(circle_at_center,rgba(255,236,214,0.7),rgba(255,255,255,0))] blur-2xl" />
    )
  }
  <svg class="absolute left-[6%] top-[12%] h-24 w-24 rotate-12 opacity-60" viewBox="0 0 100 100" data-float>
    <rect x="20" y="20" width="26" height="26" rx="6" fill="#ffd9bd"></rect>
    <circle cx="70" cy="66" r="10" fill="#c9e6ff"></circle>
  </svg>
  <svg class="absolute right-[12%] top-[46%] h-20 w-20 -rotate-12 opacity-60" viewBox="0 0 100 100" data-float>
    <path d="M50 8 92 88H8z" fill="#d6ecff"></path>
  </svg>
</div>
