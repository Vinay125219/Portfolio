---
import { exploreMore } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  intro?: string;
}

const {
  intro = 'Jump to different sections to know more about my work, skills and experience.',
} = Astro.props;
---

<section class="relative mx-auto mt-16 max-w-7xl px-5 sm:px-8" data-animate data-animate-scroll>
  <div class="card grid gap-6 p-6 md:grid-cols-[15rem_1fr] md:p-8">
    <div>
      <span class="flex items-center gap-2.5 font-display text-xl font-extrabold text-navy-950">
        <span class="h-1 w-8 rounded-full bg-gradient-to-r from-brand-500 to-aqua-400"></span>
        Explore More
      </span>
      <p class="mt-3 text-sm leading-relaxed text-navy-500">{intro}</p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        exploreMore.map((item) => (
          <a
            href={item.href}
            class="group relative overflow-hidden rounded-2xl border border-ice-100 bg-ice-50/70 p-4 transition hover:-translate-y-1 hover:border-brand-300 hover:bg-white hover:shadow-[0_18px_36px_-24px_rgba(13,60,140,0.5)]"
          >
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-aqua-400 text-white shadow-[0_10px_20px_-10px_rgba(29,110,245,0.8)]">
              <Icon name={item.icon} class="h-4.5 w-4.5" />
            </span>
            <p class="mt-3 font-display text-sm font-extrabold text-navy-950">{item.title}</p>
            <p class="mt-1 text-xs leading-relaxed text-navy-500">{item.body}</p>
            {'tech' in item && item.tech && (
              <div class="mt-3 flex gap-1.5 text-brand-500">
                {item.tech.slice(0, 4).map((t) => (
                  <span class="grid h-6 w-6 place-items-center rounded-md bg-white text-[0.6rem] font-bold shadow-sm">
                    <Icon name={t} class="h-3.5 w-3.5" />
                  </span>
                ))}
              </div>
            )}
            <span class="absolute bottom-4 right-4 grid h-8 w-8 place-items-center rounded-full border border-ice-200 bg-white text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white">
              <Icon name="chevron-right" class="h-4 w-4" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
