---
import { education } from '../data/education';
import Icon from './Icon.astro';
---

<section class="card mt-6 grid gap-6 p-6 md:grid-cols-[15rem_1fr] md:p-8" data-animate data-animate-scroll>
  <div>
    <span class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-2xl bg-brand-50 text-brand-600">
        <Icon name="cap" class="h-5 w-5" />
      </span>
      <span class="font-display text-2xl font-extrabold">Education</span>
    </span>
    <p class="mt-3 text-sm leading-relaxed text-navy-500">
      My academic background that built the foundation for my journey.
    </p>
  </div>

  <div class="grid gap-3 lg:grid-cols-3">
    {
      education.map((item) => (
        <article class="rounded-2xl border border-ice-100 bg-ice-50/70 p-4 transition hover:border-brand-200 hover:bg-white">
          <div class="flex items-start justify-between gap-2">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-white text-brand-600 shadow-sm">
              <Icon name={item.icon} class="h-4.5 w-4.5" />
            </span>
            <span class="chip !bg-white !py-0.5 !text-[0.66rem]">{item.metric}</span>
          </div>
          <h3 class="mt-3 font-display text-[0.95rem] font-extrabold leading-snug text-navy-950">
            {item.degree}
          </h3>
          <p class="mt-1 flex flex-wrap items-center gap-x-2 text-[0.78rem] font-semibold text-navy-500">
            {item.school}
            <span class="chip !py-0.5 !text-[0.64rem]">{item.period}</span>
          </p>
          <p class="mt-2 text-[0.78rem] leading-relaxed text-navy-400">{item.note}</p>
        </article>
      ))
    }
  </div>
</section>
