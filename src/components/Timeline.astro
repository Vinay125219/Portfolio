---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  entries: CollectionEntry<'experience'>[];
  showAnnotation?: boolean;
}

const { entries, showAnnotation = false } = Astro.props;
---

<div class="card relative p-5 sm:p-7">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-start gap-3">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand-600 to-aqua-400 text-white shadow-[0_14px_26px_-14px_rgba(29,110,245,0.9)]">
        <Icon name="workflow" class="h-5 w-5" />
      </span>
      <div>
        <h2 class="text-2xl font-extrabold">My Experience</h2>
        <p class="mt-1 text-sm text-navy-500">
          A timeline of my professional journey, key contributions and the impact I've created.
        </p>
      </div>
    </div>
    {
      showAnnotation && (
        <p class="annotation hidden shrink-0 text-right text-lg xl:block">
          Learning, Building,<br />Creating Impact<br />Continuously
        </p>
      )
    }
  </div>

  <ol class="relative mt-7 space-y-5">
    <span
      class="absolute bottom-4 left-[6.6rem] top-4 hidden w-px border-l-2 border-dashed border-brand-200 sm:block"
      aria-hidden="true"
    ></span>

    {
      entries.map((entry) => (
        <li class="relative grid gap-3 sm:grid-cols-[6rem_1fr] sm:gap-5">
          <div class="hidden pt-4 text-right sm:block">
            <span class="block text-[0.78rem] font-bold text-navy-800">
              {entry.data.period.split('—')[0].trim()}
            </span>
            <span class="block text-[0.7rem] font-medium text-navy-400">
              — {entry.data.period.split('—')[1]?.trim() ?? ''}
            </span>
          </div>

          <span
            class:list={[
              'absolute -left-[1.9rem] top-6 hidden h-4 w-4 rounded-full border-4 border-white sm:block',
              entry.data.current ? 'bg-brand-500 dot-glow' : 'bg-aqua-400',
            ]}
            aria-hidden="true"
          />

          <div class="card card-hover !rounded-2xl p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="text-[0.72rem] font-bold uppercase tracking-[0.14em] text-brand-600 sm:hidden">
                  {entry.data.period}
                </span>
                <h3 class="font-display text-lg font-extrabold text-navy-950">{entry.data.role}</h3>
                <p class="text-sm font-semibold text-navy-500">
                  {entry.data.company}{entry.data.company.includes(entry.data.location.split(',')[0]) ? '' : ` · ${entry.data.location}`}
                </p>
              </div>
              {entry.data.current && (
                <span class="chip !bg-emerald-50 !text-emerald-700 !border-emerald-200">
                  <span class="h-2 w-2 rounded-full bg-emerald-500" /> Current
                </span>
              )}
            </div>

            <ul class="mt-3 space-y-2">
              {entry.data.bullets.map((bullet) => (
                <li class="flex gap-2.5 text-[0.86rem] leading-relaxed text-navy-500">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400" />
                  {bullet}
                </li>
              ))}
            </ul>

            <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-ice-100 pt-3">
              <span class="flex items-center gap-1.5 text-xs font-bold text-navy-400">
                <Icon name="folder" class="h-3.5 w-3.5 text-brand-500" />
                Related Projects:
              </span>
              {entry.data.related.map((rel) =>
                rel.href ? (
                  <a href={rel.href} class="chip hover:border-brand-300 hover:text-brand-600">
                    {rel.label}
                    <Icon name="chevron-right" class="h-3 w-3" />
                  </a>
                ) : (
                  <span class="chip">{rel.label}</span>
                )
              )}
            </div>

            <span class="mt-3 block text-[0.72rem] font-semibold text-navy-300 sm:hidden">
              {entry.data.period}
            </span>
          </div>
        </li>
      ))
    }
  </ol>
</div>
